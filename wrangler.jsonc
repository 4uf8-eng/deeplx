{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0683776530525dfb1f3366cce26116f5",
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS"
    }
  ],
  "compatibility_date": "2025-07-19",
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "773e1c4b7e884adca31fc7d4923ab728"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "825381a02b4c4c7c820b1a0737ec4e96"
